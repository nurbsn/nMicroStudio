{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run microStudio Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-microstudio",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-microstudio/dist/**/*.js"
      ],
      "preLaunchTask": "npm: compile (vscode-microstudio)"
    }
  ]
}
